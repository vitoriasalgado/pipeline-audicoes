# Copie este arquivo para .env e preencha com seus valores reais.
# O .env está no .gitignore e NUNCA deve ir para o Git.

LASTFM_API_KEY=cole_sua_chave_aqui
LASTFM_USER=seu_usuario_do_lastfm

# Airflow: no LINUX, descomente e use o seu id de usuário (`id -u`), senão os
# arquivos em dags/ e logs/ ficam como root. No macOS/Windows pode ignorar.
# AIRFLOW_UID=50000

# Spotify (Fase 2b) — do dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=cole_seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=cole_seu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback